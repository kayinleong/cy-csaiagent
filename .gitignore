# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase emulator runtime artifacts
firebase-debug.log
firestore-debug.log
firestore-debug.*.log
ui-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.sample

# service-account keys / credentials — NEVER commit
sa.json
*service-account*.json
*serviceAccount*.json
*-credentials.json
firebase-adminsdk-*.json
*.pem
*.key

# quick-kayinleong-039 scraped data dumps — contain agent contact info (PIC names,
# WhatsApp numbers) + are large + regenerable; the data lives in Firestore inventory.
/projects.json
/projects.inventory.json
/drive-documents.json

# quick-kayinleong-088: the Drive ingest ledger. Regenerable from Firestore via
# scripts/scrape-skool/rebuild-kb-ledger.ts, and it names every Drive file — same
# contact-info exposure as the dumps above.
/drive-kb-ledger.json

# Scraper session state — these hold LIVE Skool and Google auth cookies. Committing one
# hands over an authenticated session. `.env*` above already covers env files; these are
# the browser-session equivalents and were not covered by any pattern.
/skool-state.json
/google-state.json
/google-profile/
/google-login.ok
/google-login.fail

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
