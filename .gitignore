# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase emulator runtime artifacts
firebase-debug.log
firestore-debug.log
firestore-debug.*.log
ui-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.sample

# service-account keys / credentials — NEVER commit
sa.json
*service-account*.json
*serviceAccount*.json
*-credentials.json
firebase-adminsdk-*.json
*.pem
*.key

# quick-kayinleong-039 scraped data dumps — contain agent contact info (PIC names,
# WhatsApp numbers) + are large + regenerable; the data lives in Firestore inventory.
/projects.json
/projects.inventory.json
/drive-documents.json

# quick-kayinleong-088: the Drive ingest ledger. Regenerable from Firestore via
# scripts/scrape-skool/rebuild-kb-ledger.ts, and it names every Drive file — same
# contact-info exposure as the dumps above.
/drive-kb-ledger.json

# Scraper session state — these hold LIVE Skool and Google auth cookies. Committing one
# hands over an authenticated session. `.env*` above already covers env files; these are
# the browser-session equivalents and were not covered by any pattern.
/skool-state.json
/google-state.json
/google-profile/
/google-login.ok
/google-login.fail

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# quick-kayinleong-090: workbook value export. Same contact-info exposure as the
# dumps above (full description prose), and regenerable from Firestore on demand.
/projects.export.json

# quick-kayinleong-090: the LIVE build of the client workbook. Holds real values and
# description prose (24 of 87 carry agent contact details). Regenerable; never commit.
/.planning/quick/quick-kayinleong-090/D2-Property-Data-Gaps-LIVE.xlsx

# quick-kayinleong-091: the raw Skool dump. Every write-up verbatim, including the
# PIC / project-leader contact details the client asked to keep unredacted.
# Regenerable from the committed scripts + a fresh scrape; never commit.
/.planning/quick/quick-kayinleong-091/D2-Property-Raw-Data.xlsx
/.planning/quick/quick-kayinleong-091/__pycache__/

# quick-kayinleong-092: quick-091's workbook plus the Drive document text read back
# from the KB. 2.4 MB, carries the same unredacted contact details. Regenerable.
/.planning/quick/quick-kayinleong-092/D2-Property-Raw-Data.xlsx
/.planning/quick/quick-kayinleong-092/__pycache__/

# quick-kayinleong-093: the merged sheet (Skool fields + values read out of the Drive
# docs, doc columns dropped). Same unredacted contact details. Regenerable.
/.planning/quick/quick-kayinleong-093/D2-Property-Raw-Data.xlsx
/.planning/quick/quick-kayinleong-093/__pycache__/

# quick-kayinleong-096: pre-write backups of the project records. Each backup holds the FULL
# document (minus the embedding), including description prose with PIC contact details, so it
# must never reach git (D13). The workbook itself and Python's bytecode cache are ignored too.
/.planning/quick/quick-kayinleong-096/backups/
/.planning/quick/quick-kayinleong-096/__pycache__/
/.planning/quick/quick-kayinleong-096/*.xlsx
