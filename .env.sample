# ─────────────────────────────────────────────────────────────────────────────
# D2 CS-AI Agent — environment template
# Copy to `.env.local` (Next.js loads it) and fill in real values.
# NEVER commit a populated .env file. `.env*` is gitignored.
# Region is asia-southeast1 (immovable — confirm with Derek before creating resources).
# Model IDs are resolved from Firebase Remote Config, NOT env (model-agnostic constraint).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase client SDK (browser-safe; these ARE shipped in the client bundle) ──
NEXT_PUBLIC_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<PROJECT_ID>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<PROJECT_ID>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<FIREBASE_APP_ID>

# ── Firebase Admin SDK (server-only — NEVER expose to the client) ──
# Provide the service-account JSON one of two ways:
#   (a) path to the key file:
GOOGLE_APPLICATION_CREDENTIALS=<ABSOLUTE_PATH_TO_SERVICE_ACCOUNT_JSON>
#   (b) OR the full JSON as a single-line string (App Hosting / Secret Manager friendly):
# FIREBASE_SERVICE_ACCOUNT_KEY=<SERVICE_ACCOUNT_JSON_ONE_LINE>
FIREBASE_PROJECT_ID=<PROJECT_ID>

# ── Region (immovable) ──
FIREBASE_LOCATION=asia-southeast1

# ── Anthropic (Claude via Vercel AI SDK) ──
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>

# ── Voyage AI embeddings (voyage-3-large, 1024-d) ──
VOYAGE_API_KEY=<VOYAGE_API_KEY>

# ── Upstash QStash (scheduled jobs → signed /api/jobs/*) ──
QSTASH_TOKEN=<QSTASH_TOKEN>
QSTASH_CURRENT_SIGNING_KEY=<QSTASH_CURRENT_SIGNING_KEY>
QSTASH_NEXT_SIGNING_KEY=<QSTASH_NEXT_SIGNING_KEY>

# ── Pinecone (RAG fallback only — leave blank unless SPIKE-RAG selects the fallback) ──
# PINECONE_API_KEY=<PINECONE_API_KEY>
# PINECONE_INDEX=<PINECONE_INDEX_NAME>

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
TENANT_ID=d2
